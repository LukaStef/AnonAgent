# Copy to .env and fill in. .env is gitignored and must stay that way.

# The cloud model the guard talks to.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# HMAC secret for pseudonym fingerprints. Keep it stable to make the same
# value fingerprint identically across runs; keep it private, because it is
# what stops anyone from re-deriving fingerprints from guessed values.
ANONAGENT_SECRET=
